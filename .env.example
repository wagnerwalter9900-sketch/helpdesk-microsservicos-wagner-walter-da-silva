# Copie para .env se quiser mudar algo. O arquivo .env nunca deve ir para o GitHub.
# Sem .env, tudo funciona: o Docker gera um segredo aleatório para o JWT.

# Segredo para assinar os tokens de login (mínimo 32 caracteres), usado por todos os serviços.
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, vale o segredo gerado pelo Docker (volume "segredos").
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs dos serviços (recomendado em produção)
DOCS=1
